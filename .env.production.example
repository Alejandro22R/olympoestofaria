# Plantilla de .env para producción. Copia a .env en el servidor y completa los valores.
# Nunca subas el .env real al repositorio.
APP_NAME="Olympo Estofaria"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://olympoestofaria.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=olympo
DB_USERNAME=olympo
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Correo (se configura al final; mientras tanto los avisos quedan en el registro de envíos).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@olympoestofaria.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Archivos privados en bucket S3/R2 privado (recomendado) o en el disco del servidor (private).
PRIVATE_DISK=private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Tiempo real: Reverb escucha en 127.0.0.1:8080 y Nginx lo publica por https en /app.
REVERB_APP_ID=olympo
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=olympoestofaria.com.br
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

TRUSTED_PROXIES=127.0.0.1
FORCE_HTTPS=true
SECURITY_CSP=true
SECURITY_HSTS=true
PORTAL_RATE_LIMIT=120

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_RESTORE_TEST_DATABASE=olympo_restore_test
