APP_NAME="Olympo Estofaria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=olympo
DB_USERNAME=olympo
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@olympo.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Almacenamiento privado (documentos y fotos). En producción: s3 (Cloudflare R2 / S3) con bucket privado.
PRIVATE_DISK=private

REVERB_APP_ID=olympo
REVERB_APP_KEY=olympo-key
REVERB_APP_SECRET=olympo-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Fase 7: seguridad, monitoreo y respaldos (ver docs/DEPLOY.md) ---
# Proxies de confianza (IP del balanceador, o * detrás de Cloudflare) y HTTPS.
TRUSTED_PROXIES=127.0.0.1
FORCE_HTTPS=false
SECURITY_CSP=false
SECURITY_HSTS=false
PORTAL_RATE_LIMIT=120

# Sentry (errores): vacío = desactivado. Nunca se envían datos personales (send_default_pii=false).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT="${APP_ENV}"

# Copias fuera del servidor (bucket privado S3/R2 distinto del de la app). Vacío = solo copias locales.
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
# Contraseña del ZIP de las copias (recomendado en producción; guárdala fuera del servidor).
BACKUP_ARCHIVE_PASSWORD=
# Base de datos vacía para la prueba mensual de restauración (opcional).
BACKUP_RESTORE_TEST_DATABASE=
